#!/usr/bin/env python3
# Registro por minuto do teste de estresse. Mede o que chega à saída, não só o processo:
# trocas/s = quantas vezes o buffer exibido no HDMI muda (30 para vídeo de 30 fps; 0 = tela congelada ou preta),
# erros_commit = falhas de commit atômico do mpv no último minuto (a causa da tela preta de 21-23/10),
# underrun = contador de underrun do HVS (quadro que o compositor não conseguiu montar a tempo).
# fps = taxa do vídeo em cena (a régua das trocas/s), audio = estado do PCM do fone (RUNNING ou XRUN), avsync = áudio menos vídeo em s.
import json, socket, subprocess, time, os, re
DRI = '/sys/kernel/debug/dri/0'
def mpv(prop):
  try:
    s = socket.socket(socket.AF_UNIX); s.settimeout(2); s.connect('/run/aya-stress/mpv.sock')
    s.sendall((json.dumps({'command': ['get_property', prop]}) + '\n').encode())
    r = s.recv(4096).decode().splitlines()[0]; s.close()
    return json.loads(r).get('data')
  except Exception:
    return None
def ler(p):
  try: return open(p).read()
  except Exception: return ''
def trocas(seg=2):
  t, prev, n = time.time(), None, 0
  while time.time() - t < seg:
    m = re.search(r'crtc=(pixelvalve-\d)\n\tfb=(\d+)', ler(f'{DRI}/state'))
    fb = m and m.group(2)
    n += prev is not None and fb != prev; prev = fb; time.sleep(0.01)
  return n / seg
def crtc_ativo():
  return int(bool(re.search(r'crtc\[\d+\]: pixelvalve-\d\n\tenable=1\n\tactive=1', ler(f'{DRI}/state'))))
def pcm_ativo():
  # estado do PCM de saída que estiver aberto (fone do Pi ou placa USB); 'closed' se nenhum
  import glob
  est = [ler(g).split('\n')[0].split(':')[-1].strip() for g in sorted(glob.glob('/proc/asound/card*/pcm0p/sub0/status'))]
  return next((e for e in est if e and e != 'closed'), 'closed')
run = lambda *a: subprocess.run(a, capture_output=True, text=True).stdout.strip()
vc = lambda a: run('vcgencmd', a).split('=')[-1]
mem = {l.split(':')[0]: int(l.split()[1]) for l in open('/proc/meminfo')}
erros = run('journalctl', '-u', 'aya-stress', '--since', '-60s', '--no-pager', '-q').count('Failed to commit')
linha = [time.strftime('%Y-%m-%dT%H:%M:%S'), int(float(open('/proc/uptime').read().split()[0])), vc('measure_temp').rstrip("'C"),
         vc('get_throttled'), run('systemctl', 'is-active', 'aya-stress'), run('systemctl', 'show', '-p', 'NRestarts', '--value', 'aya-stress'),
         mpv('frame-drop-count'), mpv('decoder-frame-drop-count'), mpv('time-pos'), mem['MemAvailable'] // 1024, os.getloadavg()[0],
         ler('/sys/class/drm/card0-HDMI-A-1/status').strip(), crtc_ativo(), trocas(), erros, ler(f'{DRI}/hvs_underrun').strip(),
         os.path.basename(mpv('path') or ''), mpv('container-fps'), pcm_ativo(), mpv('avsync'), mpv('display-fps')]
CSV = '/var/lib/aya-player/stress.csv'
novo = not os.path.exists(CSV)
with open(CSV, 'a') as f:
  if novo: f.write('hora,uptime_s,temp_c,throttled,player,reinicios,quedas_vo,quedas_dec,time_pos,mem_livre_mb,load1,'
                   'hdmi,crtc_ativo,trocas_s,erros_commit,underrun,arquivo,fps,audio,avsync,hz\n')
  f.write(','.join(str(x) for x in linha) + '\n')
