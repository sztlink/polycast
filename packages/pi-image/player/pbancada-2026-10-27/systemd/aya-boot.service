[Unit]
Description=aya-player tela de boot (toca aya-boot.mp4 uma vez, antes do player)
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
Before=aya-stress.service
[Service]
Type=oneshot
User=aya
Group=video
SupplementaryGroups=render
ExecStartPre=/bin/sh -c "for i in $(seq 50); do [ -e /dev/dri/card0 ] && exit 0; sleep 0.2; done; exit 1"
ExecStart=/usr/bin/mpv --no-config --vo=gpu --gpu-context=drm --hwdec=v4l2m2m --drm-drmprime-video-plane=primary --drm-draw-plane=overlay --ao=null --msg-level=all=warn /var/lib/aya-player/teste/aya-boot.mp4
TimeoutStartSec=30
[Install]
WantedBy=sysinit.target
