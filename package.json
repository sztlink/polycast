{
  "name": "polycast",
  "version": "0.1.0",
  "description": "Distributed immersive playback system — replace Resolume Arena with a cluster of cheap nodes",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "export": "npm run export --workspace=packages/exporter",
    "master": "npm start --workspace=packages/master",
    "install:all": "npm install"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
